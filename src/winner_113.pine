//@version=5
// ============================================================================
// WINNER(P) + COST(frac) — 对齐 CompMan.dll (FUN_100ccf00 / FUN_100cf400)
// 铁证: pdVar4 每根K线12字节(3float), [+0]=收盘(成本), [+0xc]=日期
//       local_208[k]=第k根收盘; WINNER(P)=成本<=P占比; COST=逆运算
// 两个版本: A) 等权(对齐dll)  B) 成交量加权(对齐TV)
// 纯 WINNER/COST, 不含 ZSHTL/ZZLKP 等衍生指标
// ============================================================================
indicator("WINNER/COST 弘历对齐", overlay=false)

weighted = input.bool(false, "成交量加权 (TV标准) / 等权(dll)")
lookback = input.int(250, "回看根数", minval=10, maxval=2000)

// WINNER(P): 成本<=P的占比
winnerP(P) =>
    cnt = 0.0
    wsum = 0.0
    for i = 0 to lookback - 1 by 1
        c = close[i]
        v = volume[i]
        if c <= P
            cnt := cnt + 1
            wsum := wsum + v
    weighted ? wsum / math.sum(volume, lookback) : cnt / lookback

// COST(frac): 累计占比达frac的价位 (WINNER逆运算, 用分位近似)
costF(frac) =>
    weighted ? ta.percentile_linear_interpolation(close, lookback, frac * 100)
             : ta.percentile_linear_interpolation(close, lookback, frac * 100)

plot(winnerP(close) * 100, "WINNER(C)%", color=color.blue)
plot(costF(0.5), "COST(50%)", color=color.orange)
hline(50, "50%", color=color.gray)
